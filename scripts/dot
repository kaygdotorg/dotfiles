#!/usr/bin/env bash

# helper functions from
# https://gitlab.com/kayg/sh-helpers

# same as -e
# exit immediately if command exits with a non-zero status
set -o errexit
# same as -u
# treat unset variables as error when substituting
set -o nounset

usage() {
    printf '%s\n' "Usage: $(basename "$0") <setup|update> <dot|zsh|zellij|doom|atuin|ssh|karabiner|nix> [nix-options]"
}

# check_if_installed(): a wrapper for `command -v` that silences the output and
# error streams.
#
# use:
#   check_if_installed cmd
check_if_installed() {
    command -v "${1}" 2>/dev/null 1>&2;
}

# check_if_installed_and_exit(): as the name implies, check if a program is installed. if
# it is, continue, otherwise exit with non-zero status.
#
# use:
#   check_if_installed_and_exit cmd
check_if_installed_and_exit() {
    if ! command -v "${1}" 2>/dev/null 1>&2; then
        printf '%s\n' "${1} is not installed. Please install ${1} to continue."
        exit 1
    fi
}

# where run_cmd keeps command output. Set DOT_LOG to keep a transcript of every
# command; otherwise output is captured per-command and shown only on failure.
logfile="${DOT_LOG:-}"

# run_cmd(): run a command quietly, printing a user-friendly "done" or "failed".
#
# Output is captured rather than discarded: a failing command prints what it
# said before exiting, so "failed" is never the only thing you get.
#
# use:
#   run_cmd cmd
run_cmd() {
    if [ "${#}" -eq 0 ]; then
        printf '%s\n' "No arguments provided. Exiting."
        exit 1
    fi

    capture="$(mktemp)"

    if "$@" 1>"${capture}" 2>&1; then
        printf " done\n"
        save_log "${capture}"
        rm -f "${capture}"
    else
        printf " failed\n"
        printf '%s\n' "  command: $*"
        sed 's/^/  | /' "${capture}"
        save_log "${capture}"
        rm -f "${capture}"
        exit 1
    fi
}

# save_log(): append a captured transcript to ${logfile}, if one was requested.
#
# use:
#   save_log /path/to/capture
save_log() {
    if [ -n "${logfile}" ]; then
        cat "${1}" >> "${logfile}"
    fi
}

# backup_if_real(): make a destination safe to replace. Real files and
# directories are moved aside, while symlinks are removed as links themselves.
# Removing the link first is important on platforms where `ln -sf` or `mv`
# follows a symlink to a directory and writes inside an unrelated target.
#
# use:
#   backup_if_real /path/that/is/about/to/become/a/symlink
backup_if_real() {
    if [ -L "${1}" ]; then
        printf '%s' "Removing existing symlink ${1}"
        run_cmd rm -f "${1}"
    elif [ -e "${1}" ]; then
        local backup_path backup_stamp backup_index
        backup_stamp="$(date +%Y%m%d%H%M%S)"
        backup_path="${1}.bak.${backup_stamp}"
        backup_index=0
        while [ -e "${backup_path}" ] || [ -L "${backup_path}" ]; do
            backup_index=$((backup_index + 1))
            backup_path="${1}.bak.${backup_stamp}.${backup_index}"
        done
        printf '%s' "Backing up existing ${1}"
        run_cmd mv "${1}" "${backup_path}"
    fi
}

# script local variables
script_path="$(dirname "$(realpath "${0}")")"
repo_path="$(dirname "${script_path}")"

# dot
# Linking: scripts/dot → ~/.local/bin/dot
setup_dot() {
    printf '%s' "Creating ${HOME}/.local/bin"
    run_cmd mkdir -p "${HOME}/.local/bin"

    backup_if_real "${HOME}/.local/bin/dot"

    printf '%s' "Adding dot to ${HOME}/.local/bin"
    run_cmd ln -sf "${script_path}/dot" "${HOME}/.local/bin/dot"
}

update_dot() {
    printf '%s' "Updating dotfiles repository"
    # The daily OmniWM updater may leave a reviewed package pin unstaged.
    # Let Git stash and reapply local changes around the pull so that generated
    # pins and ordinary local edits do not block a rebase-based update.
    run_cmd git -C "${repo_path}" pull --autostash

    # Git can report success after the pull itself when reapplying the
    # autostash leaves conflicts. Do not claim the update succeeded while the
    # checkout is unmerged; the autostash remains available for recovery.
    conflicts="$(git -C "${repo_path}" diff --name-only --diff-filter=U)"
    if [ -n "${conflicts}" ]; then
        printf '%s\n' "Git pull completed, but reapplying the autostash left conflicts in:" >&2
        printf '%s\n' "${conflicts}" >&2
        printf '%s\n' "Inspect 'git status' and 'git stash list', then resolve the conflicts manually." >&2
        exit 1
    fi
}

# zellij
# Linking: zellij/config.kdl      → ~/.config/zellij/config.kdl
#          zellij/layouts/kayg.kdl → ~/.config/zellij/layouts/kayg.kdl
# Downloading: hash-pinned releases named in zellij/plugins.lock →
#              ~/.config/zellij/plugins/
#
# Zellij itself is a user package owned by Home Manager/Nix. This script owns
# only dotfiles and explicitly approved plugin artifacts.
zellij_src="${repo_path}/zellij"
zellij_dest="${HOME}/.config/zellij"

sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "${1}" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "${1}" | awk '{print $1}'
    else
        printf '%s\n' "Missing checksum command (sha256sum or shasum)."
        exit 1
    fi
}

escape_kdl_string() {
    local value="${1}"

    # KDL string escaping is separate from sed replacement escaping. Keep the
    # path valid when HOME contains a backslash, quote, or control character.
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\n'/\\n}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\t'/\\t}"
    value="${value//$'\b'/\\b}"
    value="${value//$'\f'/\\f}"
    printf '%s' "${value}"
}

validate_zellij_config() {
    local config_path="${1}"
    local capture

    capture="$(mktemp)"
    if zellij --config "${config_path}" --config-dir "${zellij_src}" setup --check >"${capture}" 2>&1; then
        save_log "${capture}"
        rm -f "${capture}"
        return 0
    fi

    printf '%s\n' "Zellij rejected rendered config ${config_path}:" >&2
    sed 's/^/  | /' "${capture}" >&2
    save_log "${capture}"
    rm -f "${capture}"
    return 1
}

install_locked_zellij_plugins() {
    lockfile="${zellij_src}/plugins.lock"
    plugins_dest="${zellij_dest}/plugins"

    [ -r "${lockfile}" ] || { printf '%s\n' "Missing ${lockfile}"; exit 1; }
    printf '%s' "Creating Zellij plugin directory"
    run_cmd mkdir -p "${plugins_dest}"

    while IFS='|' read -r filename version url expected_sha; do
        case "${filename}" in ''|\#*) continue ;; esac
        # an explicit if, so shellcheck's SC2015 A&&B||C hint does not apply
        if [ -z "${version}" ] || [ -z "${url}" ] || [ -z "${expected_sha}" ]; then
            printf '%s\n' "Malformed plugin lock entry for ${filename}"
            exit 1
        fi
        destination="${plugins_dest}/${filename}"
        if [ -f "${destination}" ] && [ ! -L "${destination}" ] && \
            [ "$(sha256_file "${destination}")" = "${expected_sha}" ]; then
            printf '%s\n' "Pinned ${filename} ${version} already verified"
            continue
        fi
        temporary="$(mktemp "${destination}.tmp.XXXXXX")"
        printf '%s' "Downloading pinned ${filename} ${version}"
        if curl --fail --location --silent --show-error "${url}" -o "${temporary}" \
            && [ "$(sha256_file "${temporary}")" = "${expected_sha}" ]; then
            # A directory (or a symlink to one) is not a valid plugin artifact.
            # Move real directories aside and remove links themselves before
            # the final rename, otherwise mv may place the temporary inside it
            # and still return success.
            backup_if_real "${destination}"
            run_cmd mv "${temporary}" "${destination}"
            if [ ! -f "${destination}" ] || [ -L "${destination}" ] || \
                [ "$(sha256_file "${destination}")" != "${expected_sha}" ]; then
                printf '%s\n' "Pinned plugin ${destination} was not installed as the expected regular file."
                exit 1
            fi
        else
            rm -f "${temporary}"
            printf '%s\n' " failed checksum or download for ${filename}"
            exit 1
        fi
    done < "${lockfile}"
}

render_zellij_config() {
    local destination="${1}"
    local rendered kdl_home escaped_home

    # Keep the temporary beside the destination so the final rename is atomic
    # even when /tmp and the user's config directory are different filesystems.
    rendered="$(mktemp "${destination}.tmp.XXXXXX")"

    # HOME is inserted into a KDL string through a sed replacement. Escape the
    # KDL value first, then escape sed replacement metacharacters (including
    # the chosen `|` delimiter).
    kdl_home="$(escape_kdl_string "${HOME}")"
    escaped_home="$(printf '%s' "${kdl_home}" | sed 's/[\\&|]/\\&/g')"
    if ! sed "s|@@HOME@@|${escaped_home}|g" "${zellij_src}/config.kdl" > "${rendered}"; then
        rm -f "${rendered}"
        printf '%s\n' "Unable to render config.kdl. Check template placeholders."
        exit 1
    fi

    if ! validate_zellij_config "${rendered}"; then
        rm -f "${rendered}"
        printf '%s\n' "Rendered Zellij config was not installed; the existing config is unchanged." >&2
        exit 1
    fi

    # A generated config is already managed content. Only a different regular
    # file is treated as user content and moved aside before replacement.
    if [ -f "${destination}" ] && cmp -s "${rendered}" "${destination}"; then
        rm -f "${rendered}"
        printf '%s\n' "Zellij config already current"
        return 0
    fi
    backup_if_real "${destination}"

    printf '%s' "Installing rendered Zellij config"
    run_cmd mv "${rendered}" "${destination}"
}

setup_zellij() {
    check_if_installed_and_exit zellij
    check_if_installed_and_exit curl
    if ! command -v sha256sum >/dev/null 2>&1 && ! command -v shasum >/dev/null 2>&1; then
        printf '%s\n' "Missing checksum command: install sha256sum or shasum."
        exit 1
    fi

    printf '%s' "Creating Zellij configuration directories"
    run_cmd mkdir -p "${zellij_dest}/layouts"

    for source in config.kdl layouts/kayg.kdl; do
        destination="${zellij_dest}/${source}"
        if [ "${source}" = "config.kdl" ]; then
            printf '%s' "Rendering Zellij ${source} for ${HOME}"
            render_zellij_config "${destination}"
        else
            backup_if_real "${destination}"
            printf '%s' "Linking Zellij ${source}"
            run_cmd ln -sf "${zellij_src}/${source}" "${destination}"
        fi
    done

    install_locked_zellij_plugins

    printf '%s' "Checking Zellij configuration"
    run_cmd zellij --config "${zellij_dest}/config.kdl" setup --check
}

update_zellij() {
    # Updates deliberately do not fetch a moving 'latest' release. A reviewer
    # must update plugins.lock (version, URL, and hash) first; setup then
    # converges every machine onto those approved bytes.
    setup_zellij
    printf '%s\n' "Zellij plugins are already at the reviewed versions in plugins.lock."
}

# zsh
# Linking: zsh/.zshenv  → ~/.zshenv            (sets ZDOTDIR=~/.config/zsh)
#          zsh/.zshrc   → ~/.config/zsh/.zshrc
#          zsh/omp.yaml → ~/.config/zsh/omp.yaml
#          plugins cloned into ~/.config/zsh/plugins/
#
# oh-my-posh is a user package owned by Home Manager/Nix, not installed here.
zsh_src="${repo_path}/zsh"
zsh_dest_zsh="${HOME}/.config/zsh"
zsh_dest_plugins="${HOME}/.config/zsh/plugins"
zsh_plugins="
    https://github.com/zsh-users/zsh-autosuggestions
    https://github.com/zsh-users/zsh-completions
    https://github.com/zsh-users/zsh-history-substring-search
    https://github.com/zsh-users/zsh-syntax-highlighting
"

zsh_plugin_is_checkout() {
    local plugin_dir="${1}"
    local plugin_root expected_root plugin_git_dir

    if [ ! -d "${plugin_dir}" ] || \
        { [ ! -d "${plugin_dir}/.git" ] && [ ! -f "${plugin_dir}/.git" ]; }; then
        return 1
    fi
    plugin_root="$(git -C "${plugin_dir}" rev-parse --show-toplevel 2>/dev/null)" || return 1
    expected_root="$(cd "${plugin_dir}" && pwd -P)" || return 1
    [ "${plugin_root}" = "${expected_root}" ] || return 1
    if [ -f "${plugin_dir}/.git" ]; then
        plugin_git_dir="$(git -C "${plugin_dir}" rev-parse --git-dir 2>/dev/null)" || return 1
        case "${plugin_git_dir}" in
            */worktrees/*) ;;
            *) return 1 ;;
        esac
    fi
    git -C "${plugin_dir}" rev-parse --verify HEAD >/dev/null 2>&1
}

setup_zsh() {
    check_if_installed_and_exit git

    # Validate every pre-existing plugin path before changing zshenv or any
    # configuration. Empty/non-clone directories commonly result from an
    # interrupted clone and must not be silently treated as installed.
    for plugin in ${zsh_plugins}; do
        plugin_name="$(basename "${plugin}")"
        plugin_dir="${zsh_dest_plugins}/${plugin_name}"
        if [ -L "${plugin_dir}" ] || [ -e "${plugin_dir}" ]; then
            if ! zsh_plugin_is_checkout "${plugin_dir}"; then
                printf '%s\n' "Cannot install ${plugin}: ${plugin_dir} exists but is not a git checkout. Remove or rename it, then retry."
                exit 1
            fi
        fi
    done

    # symlink zshenv to $HOME so zsh picks up ZDOTDIR
    backup_if_real "${HOME}/.zshenv"

    printf '%s' "Linking zshenv to ${HOME}"
    run_cmd ln -sf "${zsh_src}/.zshenv" "${HOME}/.zshenv"

    # create plugin and cache directories
    printf '%s' "Creating plugin and cache directories"
    run_cmd mkdir -p "${zsh_dest_plugins}" "${zsh_dest_zsh}/cache"

    # install plugins for zsh
    printf '%s\n' 'Setting up plugins for ZSH'
    for plugin in ${zsh_plugins}; do
        plugin_name="$(basename "${plugin}")"
        plugin_dir="${zsh_dest_plugins}/${plugin_name}"

        if zsh_plugin_is_checkout "${plugin_dir}"; then
            printf '%s\n' "  Skipping ${plugin} (already exists)"
        else
            printf '%s' "  Cloning ${plugin}"
            run_cmd git -C "${zsh_dest_plugins}" clone "${plugin}"
        fi
    done

    # linking configuration
    backup_if_real "${zsh_dest_zsh}/.zshrc"

    printf '%s' 'Linking zsh configuration'
    run_cmd ln -sf "${zsh_src}/.zshrc" "${zsh_dest_zsh}/.zshrc"

    backup_if_real "${zsh_dest_zsh}/omp.yaml"

    printf '%s' 'Linking oh-my-posh configuration'
    run_cmd ln -sf "${zsh_src}/omp.yaml" "${zsh_dest_zsh}/omp.yaml"
}

update_zsh() {
    check_if_installed_and_exit git

    # Validate every declared plugin before pulling any of them. A missing,
    # corrupt, or parent-repository path must fail as a setup problem instead
    # of silently disappearing from the glob below or causing a partial update.
    for plugin in ${zsh_plugins}; do
        plugin_name="$(basename "${plugin}")"
        plugin_dir="${zsh_dest_plugins}/${plugin_name}"
        if ! zsh_plugin_is_checkout "${plugin_dir}"; then
            printf '%s\n' "Cannot update ${plugin}: ${plugin_dir} is not a valid git checkout rooted at that path." >&2
            exit 1
        fi
    done

    printf '%s\n' 'Updating plugins'
    for plugin in ${zsh_plugins}; do
        plugin_name="$(basename "${plugin}")"
        plugin_dir="${zsh_dest_plugins}/${plugin_name}"

        printf '%s' "  Updating ${plugin_name}"
        run_cmd git -C "${plugin_dir}" pull
    done
}

# atuin
# Linking: atuin/config.toml → ~/.config/atuin/config.toml
#          atuin binary linked  ~/.local/bin/atuin
#
# The Atuin binary is a user package owned by Home Manager/Nix; this block only
# links an existing ~/.atuin/bin/atuin into PATH and manages its dotfile.
atuin_src="${repo_path}/atuin"

link_atuin() {
    printf '%s' 'Creating ~/.local/bin directory'
    run_cmd mkdir -p "${HOME}/.local/bin"

    atuin_binary="$(command -v atuin)"
    if [ -z "${atuin_binary}" ]; then
        printf '%s\n' "atuin is not on PATH. Run Nix/Home Manager setup first."
        exit 1
    fi

    # symlink to ~/.local/bin so atuin stays on PATH even when a popup or
    # daemon environment does not include ~/.atuin/bin
    atuin_destination="${HOME}/.local/bin/atuin"
    if [ "${atuin_binary}" = "${atuin_destination}" ]; then
        printf '%s\n' 'Atuin is already linked into ~/.local/bin'
    else
        backup_if_real "${atuin_destination}"

        printf '%s' 'Linking atuin to ~/.local/bin'
        run_cmd ln -sf "${atuin_binary}" "${atuin_destination}"
    fi

    printf '%s' 'Creating ~/.config/atuin directory'
    run_cmd mkdir -p "${HOME}/.config/atuin"

    backup_if_real "${HOME}/.config/atuin/config.toml"

    printf '%s' 'Linking atuin configuration'
    run_cmd ln -sf "${atuin_src}/config.toml" "${HOME}/.config/atuin/config.toml"
}

setup_atuin() {
    check_if_installed_and_exit atuin
    link_atuin

    printf '%s\n' 'Run the following to complete setup:'
    printf '%s\n' '  exec zsh'
    printf '%s\n' '  atuin register -u <USERNAME> -e <EMAIL>  (or: atuin login -u <USERNAME>)'
    printf '%s\n' '  atuin import auto'
    printf '%s\n' '  atuin sync'
}

update_atuin() {
    setup_atuin
}

# doom
# Framework: ~/.config/emacs  (cloned from doomemacs/doomemacs, upstream default)
# DOOMDIR:   ~/.config/doom   (user config; `doom install` deploys the default
#            set there on first run)
#
# Emacs is a user package owned by Home Manager/Nix. The Doom CLI lives in the
# framework tree (~/.config/emacs/bin/doom).
doom_framework="${HOME}/.config/emacs"
doom_src="${repo_path}/doom-emacs"
doom_dest="${HOME}/.config/doom"

run_doom() {
    local doom_cli_path="${1}"
    shift

    # Doom's global --force suppresses prompts while run_cmd captures output,
    # and these variables keep install/sync aligned with the overlay paths.
    DOOMDIR="${doom_dest}" EMACSDIR="${doom_framework}" \
        run_cmd "${doom_cli_path}" --force "$@"
}

install_doom_file() {
    local source="${1}"
    local destination="${2}"
    local filename
    filename="$(basename "${source}")"

    if [ -f "${destination}" ] && cmp -s "${source}" "${destination}"; then
        printf '%s\n' "Doom ${filename} already current"
        return 0
    fi

    # Preserve a real file before replacing it. Symlinks are managed pointers;
    # remove a divergent one so cp cannot follow it into an unrelated target.
    if [ -e "${destination}" ] && [ ! -L "${destination}" ]; then
        backup_if_real "${destination}"
    elif [ -L "${destination}" ]; then
        printf '%s' "Removing divergent Doom ${filename} symlink"
        run_cmd rm -f "${destination}"
    fi

    printf '%s' "Installing Doom ${filename}"
    run_cmd cp -p "${source}" "${destination}"
}

overlay_doom_files() {
    local source_dir="${1}"
    local filename

    for filename in init.el config.el packages.el; do
        if [ -f "${source_dir}/${filename}" ]; then
            install_doom_file "${source_dir}/${filename}" "${doom_dest}/${filename}"
        fi
    done
}

overlay_doom_config() {
    local staging archive

    if [ -d "${doom_src}/.git" ]; then
        # Archive to a file first. Wrapping `git archive` in run_cmd and piping
        # it to tar would capture the archive bytes and pipe only " done".
        staging="$(mktemp -d "${TMPDIR:-/tmp}/dot-doom.XXXXXX")"
        archive="${staging}/doom-config.tar"
        printf '%s' "Archiving tracked Doom config"
        run_cmd git -C "${doom_src}" archive --format=tar --output="${archive}" HEAD
        printf '%s' "Extracting tracked Doom config"
        run_cmd tar -xf "${archive}" -C "${staging}"
        overlay_doom_files "${staging}"
        run_cmd rm -rf "${staging}"
    elif [ -f "${doom_src}/init.el" ]; then
        # Plain files tracked directly in this repository.
        printf '%s' "Copying tracked Doom config into ${doom_dest}"
        overlay_doom_files "${doom_src}"
    fi
}

sync_doom_runtime() {
    local doom_cli_path="${1}"

    printf '%s' "Synchronizing Doom runtime"
    run_doom "${doom_cli_path}" sync
}

setup_doom() {
    check_if_installed_and_exit emacs
    check_if_installed_and_exit git

    printf '%s' "Creating ~/.config directory"
    run_cmd mkdir -p "${HOME}/.config"

    # 1. the Doom framework (upstream default location: ~/.config/emacs)
    if [ -d "${doom_framework}/.git" ]; then
        printf '%s\n' "Doom framework already installed at ${doom_framework}"
    elif [ -e "${doom_framework}" ]; then
        printf '%s\n' "Cannot install Doom: ${doom_framework} exists and is not a Doom checkout."
        exit 1
    else
        printf '%s' "Cloning the Doom framework into ${doom_framework}"
        run_cmd git clone --depth 1 https://github.com/doomemacs/doomemacs "${doom_framework}"
    fi

    doom_cli="${doom_framework}/bin/doom"
    if [ ! -x "${doom_cli}" ] && command -v doom >/dev/null 2>&1; then
        doom_cli="$(command -v doom)"
    fi
    if [ ! -x "${doom_cli}" ]; then
        printf '%s\n' "Doom CLI not found at ${doom_framework}/bin/doom or on PATH."
        exit 1
    fi

    # 2. install packages + deploy the default config into DOOMDIR
    if [ -f "${doom_dest}/init.el" ]; then
        printf '%s\n' "Doom config already deployed at ${doom_dest}"
    else
        # Keep this synchronous: the tracked config is overlaid immediately
        # below, so it must wait until Doom has finished installing packages.
        printf '%s' "Installing Doom packages (this takes a while)"
        run_doom "${doom_cli}" install
    fi

    # 3. overlay the repo's Doom config over the deployed defaults, preserving
    # any divergent files already present in DOOMDIR.
    overlay_doom_config
    sync_doom_runtime "${doom_cli}"
}

update_doom() {
    check_if_installed_and_exit emacs
    check_if_installed_and_exit git

    if [ ! -d "${doom_framework}/.git" ]; then
        printf '%s\n' "No Doom framework at ${doom_framework}; run 'dot setup doom' first."
        exit 1
    fi
    doom_cli="${doom_framework}/bin/doom"
    if [ ! -x "${doom_cli}" ] && command -v doom >/dev/null 2>&1; then
        doom_cli="$(command -v doom)"
    fi
    if [ ! -x "${doom_cli}" ]; then
        printf '%s\n' "Doom CLI not found at ${doom_framework}/bin/doom or on PATH."
        exit 1
    fi

    printf '%s' "Updating the Doom framework"
    run_cmd git -C "${doom_framework}" pull

    # Overlay this repo's tracked Doom config (if any), then rebuild the runtime
    # so package declarations such as packages.el take effect.
    printf '%s' "Creating ${doom_dest} directory"
    run_cmd mkdir -p "${doom_dest}"
    overlay_doom_config
    sync_doom_runtime "${doom_cli}"
}

# ssh
# Linking: .ssh/config → ~/.ssh/config
# Copying: .ssh/config.local.example → ~/.ssh/config.local  (first time only)
ssh_src="${repo_path}/.ssh"
ssh_dest="${HOME}/.ssh"

validate_ssh_local_destination() {
    local destination="${ssh_dest}/config.local"

    if [ -e "${destination}" ] || [ -L "${destination}" ]; then
        if [ -f "${destination}" ]; then
            return 0
        fi
        printf '%s\n' "Cannot seed ${destination}: it exists but is not a regular file. Refusing to follow or overwrite it; remove or replace it, then retry." >&2
        exit 1
    fi
}

setup_ssh() {
    # Check this before mkdir/chmod/link work so a dangling link or directory
    # cannot trigger partial setup before the actionable failure.
    validate_ssh_local_destination

    # create ~/.ssh directory with correct permissions
    printf '%s' "Creating ${ssh_dest} directory"
    run_cmd mkdir -p "${ssh_dest}"

    printf '%s' "Setting ${ssh_dest} permissions"
    run_cmd chmod 700 "${ssh_dest}"

    # ControlPath sockets for connection multiplexing (see Host * in the config)
    printf '%s' "Creating ${ssh_dest}/sockets directory"
    run_cmd mkdir -p "${ssh_dest}/sockets"

    printf '%s' "Setting ${ssh_dest}/sockets permissions"
    run_cmd chmod 700 "${ssh_dest}/sockets"

    # link ssh config
    if [ -f "${ssh_src}/config" ]; then
        backup_if_real "${ssh_dest}/config"

        printf '%s' "Linking SSH config"
        run_cmd ln -sf "${ssh_src}/config" "${ssh_dest}/config"

        printf '%s' "Setting SSH config permissions"
        run_cmd chmod 600 "${ssh_dest}/config"
    else
        printf '%s\n' "Warning: ${ssh_src}/config does not exist. Skipping config setup."
    fi

    # ~/.ssh/config.local holds hosts that should not be published to a public
    # repository. It is Included first, so anything in it also overrides the
    # tracked defaults (ssh keeps the first value it obtains for a keyword).
    if [ ! -f "${ssh_src}/config.local.example" ]; then
        printf '%s\n' "Warning: ${ssh_src}/config.local.example is missing. Skipping config.local."
    elif [ -f "${ssh_dest}/config.local" ]; then
        printf '%s\n' "Keeping existing ${ssh_dest}/config.local"
    else
        printf '%s' "Seeding ${ssh_dest}/config.local"
        run_cmd cp "${ssh_src}/config.local.example" "${ssh_dest}/config.local"

        printf '%s' "Setting ${ssh_dest}/config.local permissions"
        run_cmd chmod 600 "${ssh_dest}/config.local"
    fi

    printf '%s\n' "SSH setup complete. Make sure your SSH keys are in ${ssh_dest}/"
}

update_ssh() {
    setup_ssh
}

# karabiner (macOS only)
# Generates: ~/.config/karabiner/karabiner.json (via writeToProfile)
karabiner_src="${repo_path}/karabiner-ts"

setup_karabiner() {
    # Karabiner-Elements is macOS only; generating a profile anywhere else just
    # writes a file nothing will ever read.
    if [ "$(uname -s)" != "Darwin" ]; then
        printf '%s\n' "Karabiner-Elements is macOS only. Nothing to do on $(uname -s)."
        exit 1
    fi

    check_if_installed_and_exit npm

    printf '%s' "Installing Karabiner configuration dependencies"
    run_cmd npm ci --prefix "${karabiner_src}"

    printf '%s' "Checking generated Karabiner-Elements configuration"
    run_cmd npm run --prefix "${karabiner_src}" check

    printf '%s' "Generating Karabiner-Elements configuration"
    run_cmd npm run --prefix "${karabiner_src}" build
}

update_karabiner() {
    setup_karabiner
}

# nix — macOS + Linux. The wizard lives in scripts/lib/nix.sh (it grew past
# what belongs inline here): detects the OS, installs Nix if missing, then wires
# the platform-specific update mechanism and Home Manager configuration.
# Home Manager owns user packages; this dispatcher only forwards the wizard's
# setup or update options.

# sourced lib is bash-flavored (local, BASH_SOURCE); linted separately as bash
# shellcheck disable=SC1091
. "${script_path}/lib/nix.sh"

setup_nix() {
    dot_nix_main "$@"
}

update_nix() {
    "${repo_path}/nix/nix-unstable-update" "$@"
}

main() {
    if [ "${#}" -lt 2 ]; then
        usage
        exit 1
    fi

    action="${1}"
    app="${2}"
    shift 2

    if [ "${#}" -gt 0 ] && [ "${app}" != "nix" ]; then
        usage
        exit 1
    fi

    case "${action}" in
        setup|update) ;;
        *)
            usage
            exit 1
            ;;
    esac

    case "${app}" in
        dot|zsh|zellij|doom|atuin|ssh|karabiner|nix) ;;
        *)
            usage
            exit 1
            ;;
    esac

    # apps that must already exist as binaries; the rest are pure dotfile
    # managers or shell-level helpers. nix is exempt because `dot setup nix`
    # is itself the installer for the Nix package manager.
    case "${app}" in
        dot|doom|karabiner|nix) ;;
        *) check_if_installed_and_exit "${app}" ;;
    esac

    "${action}_${app}" "$@"
}

main "$@"

exit 0
