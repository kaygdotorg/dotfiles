#!/usr/bin/env bash

set -euo pipefail

case "$(basename "${0}")" in
    git)
        if [ "${1:-}" = clone ]; then
            mkdir -p "${5}/.git"
        elif [ "${1:-}" = -C ] && [ "${3:-}" = archive ]; then
            exec "${DOT_TEST_REAL_GIT}" "$@"
        elif [ "${1:-}" = -C ] && [ "${3:-}" = rev-parse ]; then
            if [ "${4:-}" = --show-toplevel ]; then
                (cd "${2}" && pwd -P)
            elif [ "${4:-}" = --git-dir ]; then
                if [ -f "${2}/.git" ]; then
                    printf '%s\n' "${2}/.git/worktrees/mock"
                else
                    printf '%s\n' "${2}/.git"
                fi
            fi
        fi
        ;;
    atuin)
        ;;
    zsh)
        ;;
    *)
        printf 'unknown mock command: %s\n' "$(basename "${0}")" >&2
        exit 127
        ;;
esac
