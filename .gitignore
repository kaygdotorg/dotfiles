# SSH private keys — never commit these
.ssh/id_*
.ssh/github*
.ssh/git.kayg.org*
.ssh/known_hosts
.ssh/authorized_keys
*.pem
*.key

# Machine-local SSH config (internal hostnames, jump hosts) — the tracked
# template is .ssh/config.local.example
.ssh/config.local
.ssh/sockets/

# macOS
.DS_Store

# Editor / tool state
.claude/

# Node dependencies
node_modules/

# Local notes (not part of the dotfiles)
modern-cli-tools.md

# tmux debug logs
tmux-client-*.log
tmux-server-*.log
