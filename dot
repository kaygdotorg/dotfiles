#!/bin/sh

# helper functions from
# https://gitlab.com/kayg/sh-helpers

# same as -e
# exit immediately if command exits with a non-zero status
set -o errexit
# same as -u
# treat unset variables as error when substituting
set -o nounset

usage() {
    printf '%s\n' "Usage: $(basename "$0") <setup|update> <dot|tmux|zsh|atuin|ssh|karabiner>"
}

# check_if_installed(): a wrapper for `command -v` that silences the output and
# error streams.
#
# use:
#   check_if_installed cmd
check_if_installed() {
    command -v "${1}" 2>/dev/null 1>&2;
}

# check_if_installed_and_exit(): as the name implies, check if a program is installed. if
# it is, continue, otherwise exit with non-zero status.
#
# use:
#   check_if_installed_and_exit cmd
check_if_installed_and_exit() {
    if ! command -v "${1}" 2>/dev/null 1>&2; then
        printf '%s\n' "${1} is not installed. Please install ${1} to continue."
        exit 1
    fi
}

# run_cmd(): run commands while suppressing both the output and error streams
# and displaying a user-friendly "done" or "failed".
#
# use:
#   run_cmd cmd
run_cmd() {
    if [ "${#}" -eq 0 ]; then
        printf '%s\n' "No arguments provided. Exiting."
        exit 1
    fi

    # if ${logfile} is UNSET or EMPTY, set the value to the string "/dev/null"
    output_stream="${logfile:-/dev/null}"
    error_stream="${logfile:-/dev/null}"

    if "$@" 1>"${output_stream}" 2>"${error_stream}"; then
        printf " done\n"
    else
        printf " failed\n"
        exit 1
    fi
}

# script local variables
script_path="$(dirname "$(realpath "${0}")")"

# dot
# Linking: dot → ~/.local/bin/dot
setup_dot() {
    printf '%s' "Creating ${HOME}/.local/bin"
    run_cmd mkdir -p "${HOME}/.local/bin"

    printf '%s' "Adding dot to ${HOME}/.local/bin"
    run_cmd ln -sf "${script_path}/dot" "${HOME}/.local/bin"
}

update_dot() {
    printf '%s' "Updating dotfiles repository"
    run_cmd git -C "${script_path}" pull
}

# tmux
# Linking: tmux/.tmux.conf → ~/.config/tmux/tmux.conf
#          tpm cloned into   ~/.config/tmux/plugins/tpm
tmux_src="${script_path}/tmux"

setup_tmux() {
    printf '%s' "Creating tmux configuration directory"
    run_cmd mkdir -p "${HOME}/.config/tmux"

    printf '%s' "Linking tmux configuration"
    run_cmd ln -sf "${tmux_src}/.tmux.conf" "${HOME}/.config/tmux/tmux.conf"

    if [ -d "${HOME}/.config/tmux/plugins/tpm" ]; then
        printf 'Installing tpm (tmux plugin manager) skipped (already exists: %s)\n' "${HOME}/.config/tmux/plugins/tpm"
    else
        printf '%s' "Creating tmux plugins directory"
        run_cmd mkdir -p "${HOME}/.config/tmux/plugins"

        printf '%s' "Installing tpm (tmux plugin manager)"
        run_cmd git clone "https://github.com/tmux-plugins/tpm" "${HOME}/.config/tmux/plugins/tpm"
    fi
}

update_tmux() {
    printf '%s\n' "No framework to update. Use prefix + U to update plugins."
}

# zsh
# Linking: zsh/.zshenv  → ~/.zshenv            (sets ZDOTDIR=~/.config/zsh)
#          zsh/.zshrc   → ~/.config/zsh/.zshrc
#          zsh/omp.yaml → ~/.config/zsh/omp.yaml
#          plugins cloned into ~/.config/zsh/plugins/
#          oh-my-posh installed to ~/.local/bin/
zsh_src="${script_path}/zsh"
zsh_dest_zsh="${HOME}/.config/zsh"
zsh_dest_plugins="${HOME}/.config/zsh/plugins"
zsh_plugins="
    https://github.com/zsh-users/zsh-autosuggestions
    https://github.com/zsh-users/zsh-completions
    https://github.com/zsh-users/zsh-history-substring-search
    https://github.com/zsh-users/zsh-syntax-highlighting
"

install_oh_my_posh() {
    printf '%s' 'Installing oh-my-posh'

    missing_cmds=""
    for cmd in curl bash unzip realpath dirname mktemp; do
        if ! check_if_installed "${cmd}"; then
            missing_cmds="${missing_cmds} ${cmd}"
        fi
    done

    if [ -n "${missing_cmds}" ]; then
        printf ' skipped (missing:%s)\n' "${missing_cmds}"
        return 0
    fi

    mkdir -p "${HOME}/.local/bin"

    installer="$(mktemp)"
    if curl -LsSf https://ohmyposh.dev/install.sh -o "${installer}" \
        && bash "${installer}" -d "${HOME}/.local/bin" 1>/dev/null 2>/dev/null; then
        rm -f "${installer}"
        printf " done\n"
    else
        rm -f "${installer}"
        printf " failed\n"
        exit 1
    fi
}

setup_zsh() {
    # symlink zshenv to $HOME so zsh picks up ZDOTDIR
    printf '%s' "Linking zshenv to ${HOME}"
    run_cmd ln -sf "${script_path}/zsh/.zshenv" "${HOME}"

    # create plugin and cache directories
    printf '%s' "Creating plugin and cache directories"
    run_cmd mkdir -p "${zsh_dest_plugins}" "${zsh_dest_zsh}/cache"

    # install plugins for zsh
    printf '%s\n' 'Setting up plugins for ZSH'
    for plugin in ${zsh_plugins}; do
        plugin_name="$(basename "${plugin}")"
        plugin_dir="${zsh_dest_plugins}/${plugin_name}"

        if [ -d "${plugin_dir}" ]; then
            printf '%s\n' "  Skipping ${plugin} (already exists)"
        else
            printf '%s' "  Cloning ${plugin}"
            run_cmd git -C "${zsh_dest_plugins}" clone "${plugin}"
        fi
    done

    # linking configuration
    printf '%s' 'Linking zsh configuration'
    run_cmd ln -sf "${zsh_src}/.zshrc" "${zsh_dest_zsh}"

    printf '%s' 'Linking oh-my-posh configuration'
    run_cmd ln -sf "${zsh_src}/omp.yaml" "${zsh_dest_zsh}"

    # install oh-my-posh after config links so zsh remains usable if a dependency
    # such as unzip is missing.
    install_oh_my_posh
}

update_zsh() {
    printf '%s\n' 'Updating plugins'
    for plugin in "${zsh_dest_plugins}"/*; do
        printf '%s' "  Updating $(basename "${plugin}")"
        run_cmd git -C "${plugin}" pull
    done

    install_oh_my_posh
}

# atuin
# Linking: atuin/config.toml → ~/.config/atuin/config.toml
#          atuin binary linked  ~/.local/bin/atuin
atuin_src="${script_path}/atuin"

install_atuin() {
    printf '%s' "${1}"

    check_if_installed_and_exit curl
    check_if_installed_and_exit mktemp

    installer="$(mktemp)"
    if curl --proto '=https' --tlsv1.2 -LsSf \
        https://github.com/atuinsh/atuin/releases/latest/download/atuin-installer.sh \
        -o "${installer}" \
        && sh "${installer}" --no-modify-path --quiet 1>/dev/null 2>/dev/null; then
        rm -f "${installer}"
        printf " done\n"
    else
        rm -f "${installer}"
        printf " failed\n"
        exit 1
    fi
}

link_atuin() {
    printf '%s' 'Creating ~/.local/bin directory'
    run_cmd mkdir -p "${HOME}/.local/bin"

    # symlink to ~/.local/bin so atuin is available in tmux popups
    # (tmux global PATH doesn't include ~/.atuin/bin)
    printf '%s' 'Linking atuin to ~/.local/bin'
    run_cmd ln -sf "${HOME}/.atuin/bin/atuin" "${HOME}/.local/bin/atuin"

    printf '%s' 'Creating ~/.config/atuin directory'
    run_cmd mkdir -p "${HOME}/.config/atuin"

    printf '%s' 'Linking atuin configuration'
    run_cmd ln -sf "${atuin_src}/config.toml" "${HOME}/.config/atuin/config.toml"
}

setup_atuin() {
    if [ -x "${HOME}/.atuin/bin/atuin" ]; then
        printf '%s\n' "Atuin already installed at ${HOME}/.atuin/bin/atuin. Skipping install."
    else
        install_atuin 'Installing atuin'
    fi

    link_atuin

    printf '%s\n' 'Run the following to complete setup:'
    printf '%s\n' '  exec zsh'
    printf '%s\n' '  atuin register -u <USERNAME> -e <EMAIL>  (or: atuin login -u <USERNAME>)'
    printf '%s\n' '  atuin import auto'
    printf '%s\n' '  atuin sync'
}

update_atuin() {
    install_atuin 'Updating atuin'
    link_atuin
}

# ssh
# Linking: .ssh/config → ~/.ssh/config
ssh_src="${script_path}/.ssh"
ssh_dest="${HOME}/.ssh"

setup_ssh() {
    # create ~/.ssh directory with correct permissions
    printf '%s' "Creating ${ssh_dest} directory"
    run_cmd mkdir -p "${ssh_dest}"

    printf '%s' "Setting ${ssh_dest} permissions"
    run_cmd chmod 700 "${ssh_dest}"

    # link ssh config
    if [ -f "${ssh_src}/config" ]; then
        printf '%s' "Linking SSH config"
        run_cmd ln -sf "${ssh_src}/config" "${ssh_dest}/config"

        printf '%s' "Setting SSH config permissions"
        run_cmd chmod 600 "${ssh_dest}/config"
    else
        printf '%s\n' "Warning: ${ssh_src}/config does not exist. Skipping config setup."
    fi

    printf '%s\n' "SSH setup complete. Make sure your SSH keys are in ${ssh_dest}/"
}

# karabiner (macOS only)
# Generates: ~/.config/karabiner/karabiner.json (via writeToProfile)
karabiner_src="${script_path}/karabiner-ts"

setup_karabiner() {
    check_if_installed_and_exit npx

    printf '%s' "Generating Karabiner-Elements configuration"
    run_cmd npx --yes karabiner.ts "${karabiner_src}/index.ts"
}

update_karabiner() {
    setup_karabiner
}

main() {
    if [ "${#}" -ne 2 ]; then
        usage
        exit 1
    fi

    action="${1}"
    app="${2}"

    case "${action}" in
        setup|update) ;;
        *)
            usage
            exit 1
            ;;
    esac

    case "${app}" in
        dot|tmux|zsh|atuin|ssh|karabiner) ;;
        *)
            usage
            exit 1
            ;;
    esac

    case "${app}" in
        dot|atuin|karabiner) ;;
        *) check_if_installed_and_exit "${app}" ;;
    esac

    "${action}_${app}"
}

main "${@}"

exit 0
