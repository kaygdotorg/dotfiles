# ============================================================================
# Machine-local SSH configuration  (template)
# ============================================================================
# `dot setup ssh` copies this to ~/.ssh/config.local when that file does not
# exist, and never overwrites it afterwards. It is NOT tracked in the dotfiles
# repository, so this is where internal hostnames, jump hosts, work servers and
# per-machine overrides belong.
#
# ~/.ssh/config Includes this file FIRST, and ssh keeps the first value it
# obtains for a keyword, so anything set here overrides the tracked config.
# ============================================================================

# Example: reach the gitea box by its internal node name on the home network.
# Host git.kayg.org
#     HostName k3s-02-master-compute02

# Example: a host that only exists behind a bastion.
# Host internal-box
#     HostName 10.0.0.10
#     ProxyJump bastion.example.org
#     User kayg

# Example: a terminal whose TERM the server does not know.
# Host old-server
#     SetEnv TERM=xterm-256color
