# ============================================================================
# SSH Configuration
# ============================================================================
# This file configures SSH to use specific keys for different hosts,
# enabling easy authentication to GitHub and custom git servers.
#
# Usage: Just run `git push` or `ssh <hostname>` - SSH will automatically
# select the right key based on the host.
#
# NOTE ON ORDERING: ssh keeps the FIRST value it obtains for each keyword, so
# this file reads top to bottom as "most specific wins":
#   1. ~/.ssh/config.local  — untracked, machine-local, overrides everything
#   2. per-host blocks      — tracked defaults
#   3. Host *               — shared defaults, last so it never shadows a host
# ============================================================================

# Machine-local hosts and overrides. Not tracked in the dotfiles repository, so
# internal hostnames stay out of a public repo. Created by `dot setup ssh` from
# .ssh/config.local.example if it does not exist yet.
Include ~/.ssh/config.local

# ----------------------------------------------------------------------------
# Hosts
# ----------------------------------------------------------------------------

# GitHub - Personal repositories
#   IdentityFile matches the key file on disk (~/.ssh/github.com). With
#   IdentitiesOnly yes, ssh offers ONLY this key — so a path that does not
#   exist is not a silent fallback, it is an authentication failure.
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/github.com
    IdentitiesOnly yes

# Personal Git Server (gitea)
#   HostName is the public name so this config works from any network. If a
#   given machine has to reach it by an internal name instead, override
#   HostName in ~/.ssh/config.local — the Include above wins.
Host git.kayg.org
    HostName git.kayg.org
    User git
    IdentityFile ~/.ssh/git.kayg.org
    IdentitiesOnly yes

# ----------------------------------------------------------------------------
# Defaults for every host
# ----------------------------------------------------------------------------
# Tuned for mobile links (iPhone/iPad over cellular), where connections drop
# often and every new TCP + key exchange is felt.
Host *
    # Keepalives: notice a dead link in ~90s instead of hanging forever on a
    # session that is never coming back.
    ServerAliveInterval 30
    ServerAliveCountMax 3
    TCPKeepAlive yes

    # Connection multiplexing: subsequent connections to a host reuse the first
    # one's TCP session, so `git push` and extra shells skip the handshake
    # entirely. The socket directory is created by `dot setup ssh`.
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 10m

    # Add a key to the agent on first use rather than re-prompting all day.
    AddKeysToAgent yes

    Compression yes

    # If a terminal reports a TERM the server has no terminfo entry for
    # (xterm-ghostty is the common case — rootshell and Ghostty both use it),
    # uncomment for that host rather than globally: forcing this everywhere
    # gives up truecolor and features on servers that DO know the terminal.
    #   SetEnv TERM=xterm-256color
