{
  "name": "dotfiles-karabiner-config",
  "private": true,
  "scripts": {
    "build": "tsx index.ts",
    "check": "npm run typecheck && tsx index.ts --check",
    "test": "node --import tsx --test index.test.ts",
    "typecheck": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution Bundler --skipLibCheck index.ts index.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "karabiner.ts": "1.38.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
