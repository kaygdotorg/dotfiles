// default layout — top bar: zjstatus (floating pills from the tmux era),
// bottom bar: stock status-bar, untouched.
// zjstatus config is INLINE here (config_file is not a zjstatus option).
// bar styling mirrors the tmux pill bar: mauve active, surface1 inactive.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                // ------------------------------------------------ left ----
                format_left "#[bg=#cba6f7,fg=#1e1e2e,bold] ◆ {session} "
                // ------------------------------------------------ center ---
                format_center "#[bg=#1e1e2e]{tabs}"
                tab_normal      "#[fg=#585b70] {index} {name} "
                tab_active      "#[fg=#cba6f7,bold] {index} {name} "
                tab_separator   " "
                // ------------------------------------------------ right ---
                format_right   "#[fg=#45475a]{datetime} "
                format_datetime "#[fg=#45475a] {format_time} "
                format_time     "%H:%M"

                // floating pill feel: no border strip under the bar
                border_enabled  "true"
                border_position "top"
                border_char     "─"
                border_format   "#[fg=#1e1e2e]{char}"

                hide_frame_for_single_pane "true"

                // hide default hints to keep the pill look clean
                command_zellij_mode_indication "false"
            }
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}