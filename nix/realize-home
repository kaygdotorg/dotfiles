#!/usr/bin/env bash
#
# Substitute-only/bootstrap wrapper for nix/realize_home.py.
#
# Keep this file tiny: the policy and dependency traversal live in the Python
# program, while this wrapper only finds Python (or obtains it from the binary
# cache) and forwards the command line unchanged.

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
check_only=false
flake_ref=""
expect_flake=false
for arg in "$@"; do
    if [[ "${expect_flake}" == true ]]; then
        flake_ref="${arg}"
        expect_flake=false
    elif [[ "${arg}" == --flake=* ]]; then
        flake_ref="${arg#--flake=}"
    elif [[ "${arg}" == --flake ]]; then
        expect_flake=true
    fi
    if [[ "${arg}" == "--check" ]]; then
        check_only=true
    fi
done

nix_bin=""
if [[ -n "${REALIZE_HOME_NIX:-}" && -x "${REALIZE_HOME_NIX}" ]]; then
    nix_bin="${REALIZE_HOME_NIX}"
elif command -v nix >/dev/null 2>&1; then
    nix_bin="$(command -v nix)"
elif [[ -x /nix/var/nix/profiles/default/bin/nix ]]; then
    nix_bin="/nix/var/nix/profiles/default/bin/nix"
fi
if [[ -n "${nix_bin}" ]]; then
    nix_dir="$(dirname -- "${nix_bin}")"
    PATH="${nix_dir}:${PATH}"
    export PATH
fi

python_bin=""
if command -v python3 >/dev/null 2>&1; then
    candidate_python="$(command -v python3)"
    # realize_home.py supports Python 3.9 through postponed annotations and
    # built-in generic types.  An older system Python must go through the
    # cache path, otherwise the wrapper would fail after starting.
    if "${candidate_python}" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1; then
        python_bin="${candidate_python}"
    fi
fi

if [[ -z "${python_bin}" ]]; then
    if [[ "${check_only}" == true ]]; then
        printf '%s\n' "realize-home: --check requires python3 on PATH; refusing a cache fetch in check mode" >&2
        exit 1
    fi

    if [[ -z "${nix_bin}" ]]; then
        printf '%s\n' "realize-home: python3 and nix are unavailable" >&2
        exit 1
    fi

    if [[ -z "${flake_ref}" ]]; then
        printf '%s\n' "realize-home: --flake is required when bootstrapping python3" >&2
        exit 1
    fi
    nix_version="$("${nix_bin}" --version 2>&1 | grep -Eo '[0-9]+\.[0-9]+(\.[0-9]+)?' | tail -1 || true)"
    if [[ -z "${nix_version}" ]]; then
        printf '%s\n' "realize-home: could not determine Nix version before cache bootstrap" >&2
        exit 1
    fi
    IFS=. read -r nix_major nix_minor nix_patch <<< "${nix_version}"
    nix_patch="${nix_patch:-0}"
    if (( nix_major < 2 || (nix_major == 2 && nix_minor < 35) )); then
        printf '%s\n' "realize-home: Nix >= 2.35.0 is required; found ${nix_version}" >&2
        exit 1
    fi

    python_store="$("${nix_bin}" build \
        --no-link \
        --print-out-paths \
        --no-write-lock-file \
        --max-jobs 0 \
        --option builders '' \
        --option allow-import-from-derivation false \
        --option external-builders '[]' \
        "${flake_ref}#python3")"
    if [[ -z "${python_store}" || ! -x "${python_store}/bin/python3" ]]; then
        printf '%s\n' "realize-home: ${flake_ref}#python3 was not available from the binary cache" >&2
        exit 1
    fi
    python_bin="${python_store}/bin/python3"
fi

exec "${python_bin}" "${script_dir}/realize_home.py" "$@"
